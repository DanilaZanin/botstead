# PostgreSQL Database URL
DATABASE_URL=

# Owner API token (used by PWA, set once)
OWNER_TOKEN=

# Secret used to generate HMAC tokens for bots
BOT_TOKEN_SECRET=

# AES-256 keyring for provider API keys: id:base64(32 random bytes), newest key first.
# Example generation: openssl rand -base64 32 | tr -d '\n'
BOTHUB_SECRET_KEYS=

# Separate signing secret for per-turn model gateway tokens: openssl rand -hex 32
BOTHUB_GATEWAY_TOKEN_SECRET=

# Internal URL bots use for the model gateway inside the Docker network.
# Keep this private. Default: http://core:8080
BOTHUB_INTERNAL_URL=http://core:8080

# DEPRECATED: global allow-list of private provider hosts (comma separated). Kept as a working fallback.
# Use the per-provider allow_private flag instead: an administrator approves it in the app
# (PATCH /api/providers/{id}/allow-private), see docs/contracts.md section 11.
PROVIDER_PRIVATE_ALLOW=

# Extra networks a provider address may never point to, whatever an administrator approved (comma separated CIDR).
# The core already refuses the subnets of its own network interfaces (the Docker networks with Postgres and the bots),
# loopback, link-local and cloud metadata; list here anything else internal, for example
# PROVIDER_FORBIDDEN_CIDRS=10.20.0.0/16,fd12:3456::/32. A typo stops the core at start. Applies to PROVIDER_PRIVATE_ALLOW too.
PROVIDER_FORBIDDEN_CIDRS=

# Token for the Mac agent WebSocket connection
MAC_AGENT_TOKEN=

# Optional: Command to wake up the Mac (e.g. wakeonlan)
MAC_WOL_CMD=

# Directory for storing files (mounted in docker-compose.yml as /data/files)
FILES_DIR=

# Runner execution environment: docker (контейнеры через лаунчер) or local (for dev)
BOTHUB_RUNNER_EXEC=docker

# Web Push VAPID keys for PWA notifications
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=

# Proxy Secret for Nginx
BOTHUB_PROXY_SECRET=

# Owner username from the SSO proxy
BOTHUB_OWNER_USER=

# Time-to-live for approvals (in minutes)
APPROVAL_TTL_MINUTES=60

# How long a procedure run may wait for a human (waiting_human, waiting_approval), in hours. After that the run is
# stopped with the code wait_expired, the bot is released for turns and schedules (docs/contracts.md, section 14).
# Default 24; an empty, non-numeric or non-positive value also means 24.
BOTHUB_PROCEDURE_WAIT_HOURS=24

# Секрет между ядром и лаунчером (сервис с docker.sock): openssl rand -hex 32, не короче 32 символов
LAUNCHER_SECRET=

# Необязательный agy (Antigravity CLI) в образе ботов: прямой URL бинарника и его SHA-256.
# Оба или ни одного; без них слой agy пропускается и раннер gemini недоступен. См. README.
AGY_URL=
AGY_SHA256=

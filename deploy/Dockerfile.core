FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

# Install uv. docker CLI в образе ядра нет: контейнерами ботов занимается лаунчер (docs/isolation.md).
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

WORKDIR /app

# Copy the core package directory
COPY core/ ./core/
COPY pwa/ ./pwa/
# Версия кэша service worker от содержимого PWA: после любой правки клиенты получают свежую оболочку без ручного bump.
RUN v="$(cat pwa/index.html pwa/*.js pwa/*.css pwa/i18n/*.js | sha256sum | cut -c1-12)" \
    && sed -i "s/bothub-shell-v[0-9A-Za-z]*/bothub-shell-$v/" pwa/sw.js && grep -q "bothub-shell-$v" pwa/sw.js
ENV PWA_DIR=/app/pwa

# Install the package using uv
RUN uv pip install --system --no-cache ./core/

# Run uvicorn on port 8080
EXPOSE 8080

CMD ["uvicorn", "bothub.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
